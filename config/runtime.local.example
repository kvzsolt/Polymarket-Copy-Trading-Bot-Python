# Local non-sensitive overrides.
# Copy to: config/runtime.local.env
# Use this file for public wallet identities, local follow targets, and other
# machine-specific but non-secret runtime overrides.
# Secrets still belong in `.env`.

# -----------------------------------------------------------------------------
# Wallet / identity overrides
# -----------------------------------------------------------------------------
# Comma-separated leader wallets to follow.
LEADER_WALLETS=

# Fallback single leader wallet when LEADER_WALLETS is empty.
USER_ADDRESS=

# Wallet that funds and signs live trades.
FUNDER_ADDRESS=

# Optional allocator-style multi-user runtime config path.
MULTI_USER_CONFIG_FILE=

# -----------------------------------------------------------------------------
# Optional local behavior overrides
# -----------------------------------------------------------------------------
# Enable one-switch auto leader discovery mode.
# LEADER_AUTO=false

# Number of leaders promoted when auto mode is enabled.
# LEADER_AUTO_COUNT=5

# Override fetch cadence locally if needed.
# FETCH_INTERVAL=1
