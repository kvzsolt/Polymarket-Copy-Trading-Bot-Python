# Local non-sensitive override template.
# Copy to: config/runtime.local.env
# Recommended defaults:
# - keep live leaders explicit in LEADER_WALLETS
# - prefer LEADER_WALLETS over USER_ADDRESS for explicit follow lists
# - keep MULTI_USER_CONFIG_FILE empty unless you are running allocator / multi-user mode
# - keep machine-specific overrides here, not in `secrets.env`

# -----------------------------------------------------------------------------
# Wallet / identity overrides
# -----------------------------------------------------------------------------
# Comma-separated leader wallets to follow on this machine.
LEADER_WALLETS=

# Optional single leader fallback when LEADER_WALLETS is empty.
USER_ADDRESS=

# Wallet that funds and signs live trades for this machine.
FUNDER_ADDRESS=

# Optional multi-user runtime config path for allocator-style setups.
MULTI_USER_CONFIG_FILE=

# -----------------------------------------------------------------------------
# Optional local behavior overrides
# -----------------------------------------------------------------------------
# Override leader polling cadence locally if needed.
# FETCH_INTERVAL=0.25

# -----------------------------------------------------------------------------
# Falcon + Polymarket discovery
# -----------------------------------------------------------------------------
# Discovery is DB-only. Put FALCON_API_TOKEN in secrets.env, not here.
# Use `python bot.py rotate-traders` to edit LEADER_WALLETS.
# FALCON_MIN_WIN_RATE_15D=0.45
# FALCON_MAX_WIN_RATE_15D=0.90
# FALCON_MIN_ROI_15D=0
# FALCON_MIN_PNL_15D=100
# FALCON_MIN_TRADES_15D=30
# FALCON_MAX_TRADES_15D=750
# POLYMARKET_HISTORY_LOOKBACK_DAYS=365
# POLYMARKET_HISTORY_MIN_WINDOW_SECONDS=21600
# POLYMARKET_ACTIVITY_MAX_OFFSET=3000
# DISCOVERY_SIGNAL_GROUP_WINDOW_SECONDS=60
# DISCOVERY_MIN_COPYABLE_GROUPED_SIGNAL_RATIO=0.75
# DISCOVERY_MIN_COPYABLE_NOTIONAL_RATIO=0.60
# DISCOVERY_MIN_AUTO_SPORTS_ESPORTS_RATIO=0.75
# DISCOVERY_AUTO_PREFER_SPORTS_ESPORTS=true
# DISCOVERY_EVALUATION_TTL_SECONDS=3600
# DISCOVERY_REJECT_STALE_EVALUATIONS=true
# DISCOVERY_REQUIRE_RECENT_STATE_FOR_LIVE=true
# DISCOVERY_DYNAMIC_MONITORING_ENABLED=false
# ROTATE_TRADERS_ENV_FILE=config/runtime.local.env
