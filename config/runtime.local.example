# Local non-sensitive override template.
# Copy to: config/runtime.local.env
# Recommended defaults:
# - keep live leaders explicit in LEADER_WALLETS
# - prefer LEADER_WALLETS over USER_ADDRESS for explicit follow lists
# - keep MULTI_USER_CONFIG_FILE empty unless you are running allocator / multi-user mode
# - keep machine-specific overrides here, not in `secrets.env`

# -----------------------------------------------------------------------------
# Wallet / identity overrides
# -----------------------------------------------------------------------------
# Comma-separated leader wallets to follow on this machine.
LEADER_WALLETS=

# Optional single leader fallback when LEADER_WALLETS is empty.
USER_ADDRESS=

# Wallet that funds and signs live trades for this machine.
FUNDER_ADDRESS=

# Optional multi-user runtime config path for allocator-style setups.
MULTI_USER_CONFIG_FILE=

# -----------------------------------------------------------------------------
# Optional local behavior overrides
# -----------------------------------------------------------------------------
# Override leader polling cadence locally if needed.
# FETCH_INTERVAL=0.25

# -----------------------------------------------------------------------------
# Falcon + Polymarket discovery
# -----------------------------------------------------------------------------
# Discovery is DB-only by default. Put FALCON_API_TOKEN in secrets.env, not here.
# Use `python bot.py rotate-traders` to edit LEADER_WALLETS manually.
#
# Startup auto leader selection:
# LEADER_SOURCE=auto
# AUTO_LEADER_ENABLED=true
# AUTO_LEADER_COUNT=2
#
# Falcon candidate discovery:
# FALCON_SORT_MODES=h_score,pnl,sharpe,roi,win_rate
# FALCON_DEDUPE_CANDIDATES=true
# FALCON_MAX_CANDIDATES=250
#
# Leader scoring:
# LEADER_SCORE_VERSION=leader_score_v2
# DISCOVERY_VOLUME_TARGET_15D=10000
# DISCOVERY_MIN_VOLUME_15D=0
# DISCOVERY_RANK_TARGET=100
# DISCOVERY_RISK_PENALTY_ENABLED=true
# AUTO_LEADER_REQUIRE_SCORE_VERSION=true
#
# Safety:
# DISCOVERY_DYNAMIC_MONITORING_ENABLED=false

# -----------------------------------------------------------------------------
# Contract addresses (Polygon Mainnet, chain 137)
# -----------------------------------------------------------------------------
# These default to the canonical Polymarket V2 addresses in config/addresses.py
# and normally need no override. Both exchange contracts are used: orders are
# signed for the CTF Exchange or the Neg Risk CTF Exchange depending on the
# market's neg_risk flag, and pUSD must be approved for BOTH.
# CTF_EXCHANGE_V2_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
# NEG_RISK_CTF_EXCHANGE_V2_ADDRESS=0xe2222d279d744050d28e00520010520000310F59

# -----------------------------------------------------------------------------
# On-chain early detection (PR2)
# -----------------------------------------------------------------------------
# Mined OrderFilled log detection is always safe (authoritative). Pending-tx
# detection is provisional and OFF by default; enable only with an Alchemy
# WebSocket URL that supports alchemy_pendingTransactions.
# ENABLE_ONCHAIN_MINED_DETECTION=true
# ENABLE_ONCHAIN_PENDING_DETECTION=false
# PENDING_TX_PROVIDER=alchemy
# PENDING_TX_WS_URL=
# PENDING_TX_HASHES_ONLY=false
# PENDING_TX_MAX_SIGNAL_AGE_MS=500
# PENDING_TX_DETECTION_CONFIDENCE_REQUIRED=pending_probable
