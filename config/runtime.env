# Non-sensitive runtime configuration for the Python copy-trading bot.
# Keep secrets only in `.env`. This file is the readable operator dashboard.
# Every section below controls one engine or one operational concern.

# -----------------------------------------------------------------------------
# Process and logging.
# This section controls how noisy the bot is, where logs go, and how much log
# history is retained on disk. Change these when you need more or less runtime
# visibility, not when you want to change trading behavior.
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1 # Flush stdout and stderr immediately so logs show up in real time.
POLYMARKET_LOG_LEVEL=INFO # Console and structured log verbosity.
LOG_DIR=log # Directory where runtime log files live.
APP_LOG_JSONL_FILE=log/PolymarketCopyTradingBot.jsonl # Structured runtime JSONL audit log path.
LOG_MAX_BYTES=5242880 # Maximum size of one rotated log file in bytes.
LOG_BACKUP_COUNT=3 # Number of rotated log files to keep.

# -----------------------------------------------------------------------------
# Polymarket connectivity and signing.
# This section is the low-level exchange connection layer. Wallet type and
# signature mode are auto-detected from the signer/funder relationship plus
# chain state, so there is no manual SIGNATURE_TYPE knob here anymore.
# -----------------------------------------------------------------------------
CHAIN_ID=137 # Numeric chain id used for signing and on-chain lookups.
CLOB_HTTP_URL=https://clob.polymarket.com # Base HTTP endpoint for the Polymarket CLOB.
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174 # USDC token contract used by the bot.

# -----------------------------------------------------------------------------
# Leader discovery and polling.
# This section controls how frequently the bot polls leaders and whether leader
# auto-discovery is allowed to expand the follow list at runtime.
# -----------------------------------------------------------------------------
FETCH_INTERVAL=0.25 # Base polling interval in seconds for leader activity refreshes.
LEADER_AUTO=false # Enable automatic leader selection mode.
LEADER_AUTO_COUNT=5 # Number of leaders to activate when auto mode is enabled.
AUTO_DISCOVER_LEADERS=false # Allow discovery logic to add leaders automatically.
AUTO_DISCOVER_MAX_LEADERS=10 # Hard cap on how many leaders auto-discovery may keep.
AUTO_DISCOVER_TOP_N=5 # Number of top ranked discovered leaders to consider.
AUTO_DISCOVER_MIN_SCORE=0.45 # Minimum discovery score required for auto-added leaders.
FIND_TRADERS_TARGET=6 # Target number of traders to keep in the discovery candidate set.
FIND_TRADERS_REFRESH_SECONDS=60 # Refresh interval in seconds for trader discovery pulls.

# -----------------------------------------------------------------------------
# Strategy engine.
# This section decides how BUY size is chosen before risk caps and execution
# checks kick in. Use this to change the trading style, trust-based sizing, and
# minimum leader trade filtering without touching low-level venue rules.
# -----------------------------------------------------------------------------
ENABLE_TRUST_SIZE_MULTIPLIERS=false # Kill switch for leader trust based size scaling; false forces a neutral 1.0 multiplier.
SIZING_MODE=proportional # Strategy mode: proportional, fixed, or adaptive.
PERCENTAGE=30 # Percent of the leader trade size to copy in proportional mode.
FIXED_AMOUNT=3 # Fixed USDC amount to use in fixed mode.
TRADE_MULTIPLIER=1.0 # Global multiplier applied on top of the selected strategy size.
# Optional tiered sizing map for advanced strategy overrides.
TIERED_TRADE_MULTIPLIERS=
ADAPTIVE_SIZING_BASIS=trade_size # Adaptive sizing basis: trade_size or performance.
ADAPTIVE_MIN_PERCENT=0 # Lower bound percent used by adaptive sizing when enabled.
ADAPTIVE_MAX_PERCENT=0 # Upper bound percent used by adaptive sizing when enabled.
ADAPTIVE_THRESHOLD_USDC=500 # Reference trade size used by adaptive sizing.
BUY_MIN_AMOUNT=1 # Minimum BUY notional the strategy may request before later gates.
BUY_MAX_AMOUNT=6 # Maximum BUY notional the strategy may request before later gates.
MAX_POSITION_PCT=0.20 # Maximum fraction of current balance allowed for one position.
POSITION_THRESHOLD=0 # Minimum existing position threshold before add-on logic kicks in.
MIN_LEADER_TRADE_NOTIONAL_USDC=1.00 # Ignore leader trades below this notional because they are usually noise.
TRUST_SIZE_MULTIPLIER_MIN=0.50 # Minimum trust multiplier when trust sizing is enabled.
TRUST_SIZE_MULTIPLIER_MAX=1.25 # Maximum trust multiplier when trust sizing is enabled.

# -----------------------------------------------------------------------------
# Polymarket base execution rules.
# This section defines the raw venue execution assumptions used by the bot.
# Do not casually modify these. If you get them wrong, the bot can start
# creating nonsense sizes, venue rejects, or broken rounding behavior.
# -----------------------------------------------------------------------------
# Last-line pre-submit guard for minimum executable BUY and SELL size checks.
ENABLE_EXECUTABLE_ORDER_GUARD=false
# Do not modify lightly; baseline token floor used for executable order sizing.
COPY_MIN_SHARES=5
COPY_MIN_NOTIONAL_USDC=1 # Do not modify lightly; baseline notional floor used for executable order sizing.
COPY_SIZE_DECIMALS=4 # Do not modify lightly; decimal precision used when rounding order sizes.
EXECUTABLE_ORDER_BUFFER_NOTIONAL_USDC=1.05 # Sell-side notional buffer that helps survive rounding and venue minimum edge cases.
MIN_ORDER_SIZE=0.00001 # Minimum token amount accepted when market metadata does not provide a larger venue minimum.

# -----------------------------------------------------------------------------
# Bot throughput and rate limiting.
# This section controls how aggressively the bot fans out work. Touch these only
# if you know the latency and rate-limit consequences. Bad values can make the
# bot unstable or get Polymarket requests throttled.
# -----------------------------------------------------------------------------
TRADE_ANALYSIS_CONCURRENCY=6 # Concurrent BUY analysis tasks allowed at once.
RECONCILE_CONCURRENCY=4 # Concurrent reconciliation tasks allowed at once.
EXECUTION_SUBMIT_CONCURRENCY=3 # Concurrent order submission tasks allowed at once.
LEADER_ACTIVITY_MIN_FETCH_SPACING_MS=250 # Minimum spacing between leader activity fetches in milliseconds.
LEADER_POSITIONS_MIN_FETCH_SPACING_MS=250 # Minimum spacing between leader position fetches in milliseconds.

# -----------------------------------------------------------------------------
# Copy decision engine.
# This section is the decision layer that scores copied BUYs before execution.
# Enable it when you want the bot to reject weak or stale BUYs instead of trying
# almost everything that passed sizing and risk caps.
# -----------------------------------------------------------------------------
ENABLE_COPY_DECISION_GATE=false # Kill switch for the BUY decision scoring gate.
COPY_DECISION_MIN_SCORE=0.15 # Minimum BUY score required when the decision gate is enabled.
COPY_MAX_PRICE_DRIFT_PCT=15 # Maximum price drift allowed between leader fill and current market price.
COPY_MAX_EDGE_DECAY_PCT=90 # Maximum edge decay allowed before a copied BUY is rejected.
COPY_MAX_SIGNAL_AGE_SECONDS=100 # Maximum BUY signal age in seconds before it is considered stale.
COPY_LIQUIDITY_TARGET_USDC=50 # Target liquidity reference used by decision scoring.
TINY_LEADER_HIGH_CONFIDENCE_SCORE=0.75 # Confidence shortcut used when tiny leader trades still look very strong.

# -----------------------------------------------------------------------------
# Leader scoring engine.
# This section decides how leader trust is computed. These values shape the
# trust score itself, which can later be used by strategy sizing and tier logic.
# -----------------------------------------------------------------------------
LEADER_SCORE_BALANCE_TARGET_USDC=500 # Balance level that maps to a full balance score.
LEADER_SCORE_PNL_BONUS_CAP=0.10 # Maximum PnL bonus contribution added to analytics score.
LEADER_SCORE_ACTIVITY_TARGET=8 # Recent trade count that maps to a full activity score.
LEADER_SCORE_WEIGHT_BALANCE=0.35 # Weight assigned to leader balance in the trust score.
LEADER_SCORE_WEIGHT_ANALYTICS=0.45 # Weight assigned to analytics quality in the trust score.
LEADER_SCORE_WEIGHT_ACTIVITY=0.20 # Weight assigned to recent trading activity in the trust score.
LEADER_SCORE_FLOOR=0.10 # Minimum trust score floor after combining the components.

# -----------------------------------------------------------------------------
# Execution quality engine.
# This section covers slippage, retries, book quality, and market freshness. It
# is about whether the bot should attempt execution under current market quality,
# not about long-term risk policy.
# -----------------------------------------------------------------------------
ENABLE_NEAR_RESOLUTION_GATE=false # Kill switch for rejecting stale BUYs near resolution.
SLIPPAGE_TOLERANCE=2.0 # Maximum allowed slippage percentage on execution.
MIN_SHARE_PRICE=0.01 # Reject BUYs below this price; set 0 to disable the floor.
MAX_SHARE_PRICE=0.98 # Reject BUYs above this price; set 0 to disable the ceiling.
MAX_RETRIES=3 # Maximum submit attempts for exchange order placement.
NON_TERMINAL_FAILURE_MAX_ATTEMPTS=3 # Maximum ambiguous failure retries before giving up.
RETRY_BACKOFF_BASE=1.0 # Base seconds for exponential retry backoff.
AGGREGATE_SIGNAL_WINDOW_SECONDS=0.1 # Window in seconds used to aggregate nearby signals.
TRANSACTION_FEE_BPS=20 # Fee model used by pre-trade execution scoring.
GAS_COST_USDC=0.03 # Gas cost model used by pre-trade execution scoring.
RISK_BUFFER_PCT=0.10 # Extra sizing buffer applied before execution approval.
BOOK_SPREAD_MODE=absolute_bps # Spread gate mode: absolute_bps, relative_bps, or ticks.
MAX_BOOK_SPREAD_BPS=2500 # Maximum acceptable spread in basis points when using a bps mode.
MAX_BOOK_SPREAD_TICKS=0 # Maximum acceptable spread in ticks when BOOK_SPREAD_MODE=ticks.
EXECUTION_REQUIRE_FRESH_BOOK=true # Force fresh orderbook reads for execution-time quality checks.
NEAR_RESOLUTION_GATE_PRICE=0.95 # Price threshold where near-resolution stale rejection begins.
NEAR_RESOLUTION_MAX_AGE_SECONDS=15 # Maximum signal age allowed once a market is near resolution.
PENDING_SUBMISSION_TTL_SECONDS=120 # Expire stale pending submission locks after this many seconds.
CIRCUIT_FAILURE_THRESHOLD=15 # Trip the execution circuit breaker after this many consecutive failures.
CIRCUIT_COOLDOWN_SECONDS=60 # Seconds to wait before the execution circuit breaker reopens.
META_CACHE_TTL_GOOD=300 # Cache TTL in seconds for healthy market metadata.
META_CACHE_TTL_THIN=30 # Cache TTL in seconds for thin or suspicious market metadata.

# -----------------------------------------------------------------------------
# Risk management engine.
# This is the global master switch for all sell-side risk behavior. If this is
# false, the risk monitor sleeps and every exit sub-engine is disabled, even if
# the individual sub-switch below is set to true.
# -----------------------------------------------------------------------------
ENABLE_RISK_MGMT=false # Global master switch for the entire sell-side risk management system.
KILL_SWITCH=false # Global stop-trading switch.
RISK_CHECK_INTERVAL=0.5 # Seconds between risk-price cache refreshes and open-position exit scans.
MAX_OPEN_POSITIONS=40 # Hard cap on simultaneously open positions.

# -----------------------------------------------------------------------------
# Risk management sub-engines.
# The old primitive hard stop-loss and legacy single take-profit have been
# retired from the live system. Use the more contextual exit engines below.
# -----------------------------------------------------------------------------
ENABLE_PROFIT_LOCK=false # Enable the profit-lock exit sub-engine.
PROFIT_LOCK_TRIGGER_PCT=100 # Profit percent that triggers the profit-lock partial sell.
ENABLE_NEAR_MAX_EXIT=false # Enable the near-max-price exit sub-engine.
NEAR_MAX_PRICE_WARN=0.94 # Warning threshold for near-max-price exit logic.
NEAR_MAX_PRICE_WARN_TRIM_RATIO=0.8 # Fraction to trim when only the warn threshold is hit.
NEAR_MAX_PRICE_EXIT=0.97 # Exit threshold for near-max-price logic.
ENABLE_TRAILING_STOP=false # Enable the trailing-stop exit sub-engine.
TRAILING_ACTIVATION_PCT=70 # Profit percent that activates trailing-stop tracking.
TRAILING_DISTANCE=0.12 # Absolute price pullback from the local peak that triggers a trailing-stop exit.
ENABLE_STOP_LOSS=false # Enable the stop-loss exit sub-engine.
STOP_LOSS_THRESHOLD=0.20 # Absolute share price floor; full exit if price drops at or below this.
STOP_LOSS_GRACE_PERIOD_SECONDS=120 # Seconds after entry during which stop-loss is suppressed.
ENABLE_STAGED_TP=false # Enable the staged take-profit exit sub-engine.
STAGED_TP_LEVELS=30,50 # Profit levels used by staged take-profit logic.
STAGED_TP_FRACTIONS=0.25,0.35 # Fractions sold at each staged take-profit level.
ENABLE_LEADER_DIVERGENCE_EXIT=false # Enable exits when the leader meaningfully diverges.


# -----------------------------------------------------------------------------
# Balance policy engine.
# This section caps trade sizing based on account equity and reserve policy.
# These values protect the account from over-concentration even if the strategy
# and decision layers both want to trade larger size.
# -----------------------------------------------------------------------------
# Enable account-cap and reserve policy enforcement to stop deposit-wide over-allocation.
ENABLE_BALANCE_TIERED_POLICY=true
DAY_START_EQUITY_USDC=50 # Reference day-start equity used by the balance policy.
BALANCE_POLICY_RESERVE_PCT=0.12 # Fraction of equity reserved and not allocated to new trades.
BALANCE_POLICY_RESERVE_FLOOR=7 # Minimum USDC reserve kept even on small balances.
BALANCE_POLICY_HARD_CAP_PCT=0.15 # Hard cap fraction of equity allowed for one trade.
BALANCE_POLICY_HARD_CAP_CEILING=8 # Maximum USDC cap allowed even if the percentage would be larger.
BALANCE_POLICY_MAX_OPEN_POSITIONS=12 # Policy-specific cap on simultaneous open positions.
BALANCE_POLICY_ALLOW_PARTIAL_EXITS=true # Allow partial exits when the balance policy intervenes.
BALANCE_POLICY_ALLOW_PYRAMIDING=false # Allow adding to an already open position.
BALANCE_POLICY_MAX_ADDS_PER_POSITION=1 # Maximum number of adds allowed for one position.
BALANCE_POLICY_BASE_MIN_SCORE=0.22 # Minimum score used by the balance policy when scoring is active.
BALANCE_POLICY_MIN_NOTIONAL_USDC=0.00001 # Smallest notional the balance policy may allow.
BALANCE_POLICY_DYNAMIC_THRESHOLD_RAISE=false # Dynamically raise thresholds when balance pressure increases.



# -----------------------------------------------------------------------------
# Discovery and tiering engines.
# This section controls watchlist logging, promotion thresholds, and external
# trader discovery. These settings decide who is worth following and at which
# tier, not how orders are executed.
# -----------------------------------------------------------------------------
ENABLE_TIER_GATE_WATCHLIST=false # Enable watchlist gating for weak leaders.
ENABLE_TIER_GATE_WATCHLIST_LOG=false # Emit extra logs when watchlist gating decisions happen.
ENABLE_TRADER_DISCOVERY=false # Enable external trader discovery enrichment.
DISCOVERY_INTERVAL_SECONDS=3600 # Seconds between discovery refresh runs.
DISCOVERY_PROMOTE_TO_ACTIVE=false # Allow discovery to promote leaders directly into active follow sets.
MIN_LEADER_PNL=1000 # Minimum historical PnL required by discovery filters.
MIN_LEADER_WIN_RATE=0.55 # Minimum win rate required by discovery filters.
MIN_LEADER_POSITIONS=20 # Minimum total positions required by discovery filters.
DISCOVERY_MAX_RESULTS=50 # Maximum number of discovery candidates to keep.
TIER_PROMOTE_TO_PAPER=0.40 # Score threshold to promote a leader from watchlist to paper follow.
TIER_PROMOTE_TO_LIVE=0.55 # Score threshold to promote a leader from paper to live follow.
TIER_MIN_PAPER_SECONDS=86400 # Minimum time in seconds a leader should stay in paper before live promotion.
TIER_DEMOTE_TO_PAPER=0.35 # Score threshold below which a live leader falls back to paper.
TIER_DEMOTE_TO_WATCHLIST=0.25 # Score threshold below which a paper leader falls back to watchlist.

# -----------------------------------------------------------------------------
# Paper/live safety and geographic controls.
# This section contains global runtime safety toggles that are not specific to
# one trading engine but still materially change whether live execution happens.
# -----------------------------------------------------------------------------
PAPER_TRADE_ONLY=false # Force all live-follow leaders into paper mode.
ENFORCE_GEOBLOCK=true # Enforce geoblock checks before live trading.

# -----------------------------------------------------------------------------
# Storage and persistence.
# This section controls local durable state so the bot can recover positions,
# fills, and realized PnL across restarts.
# -----------------------------------------------------------------------------
BOT_STATE_DB_ENABLED=true # Enable SQLite state persistence.
BOT_STATE_DB=data/bot_state.db # SQLite database file path.
PNL_LOG_FILE=log/pnl.jsonl # Append-only realized and unrealized PnL JSONL output.
# Optional allocator-style multi-user runtime config file path.
MULTI_USER_CONFIG_FILE=

# -----------------------------------------------------------------------------
# Metrics and reconciliation engines.
# This section controls health endpoints and order reconciliation behavior. Use
# it to tune observability and stale-order cleanup cadence.
# -----------------------------------------------------------------------------
ENABLE_METRICS_SERVER=false # Kill switch for the metrics HTTP server.
METRICS_PORT=9102 # TCP port for the metrics server.
METRICS_BIND_HOST=127.0.0.1 # Bind host for the metrics server.
RECONCILE_STALE_SECONDS=3600 # Age in seconds after which submitted orders are considered stale.
RECONCILE_AUTO_CANCEL=false # Automatically cancel stale orders during reconciliation.
RECONCILE_INTERVAL_SECONDS=300 # Seconds between reconciliation passes.

# -----------------------------------------------------------------------------
# Auto-redeem engine.
# This section controls whether redeemed winning positions are automatically
# swept and how frequently that redemption loop wakes up.
# -----------------------------------------------------------------------------
ENABLE_AUTO_REDEEM=false # Kill switch for the auto-redeem engine.
REDEEM_CHECK_INTERVAL=60 # Seconds between redemption checks.

# -----------------------------------------------------------------------------
# Negative-risk arbitrage engine.
# This section controls the optional neg-risk scanner. Leave it off unless you
# explicitly want the bot running a separate arbitrage workflow.
# -----------------------------------------------------------------------------
ENABLE_NEG_RISK_ARB=false # Kill switch for the neg-risk arbitrage engine.
ARB_MIN_PROFIT_BPS=30 # Minimum modeled edge in basis points before taking an arb.
ARB_MAX_COST_USDC=10 # Maximum USDC cost allowed for one arbitrage bundle.
ARB_MIN_ASK_DEPTH=20 # Minimum ask depth required before the arb is considered real.
ARB_SCAN_INTERVAL=30 # Seconds between arb scans.
ARB_MAX_CONCURRENT=3 # Maximum concurrent arb tasks.
