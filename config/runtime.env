# Non-sensitive runtime configuration for the Python copy-trading bot.
# Keep secrets only in `.env`.

# -----------------------------------------------------------------------------
# Process / logging
# Recommended defaults:
# - POLYMARKET_LOG_LEVEL=INFO for production-like runs
# - LOG_DIR=log unless you intentionally centralize logs elsewhere
# - LOG_MAX_BYTES=5242880 and LOG_BACKUP_COUNT=3 for small rotating JSONL logs
# -----------------------------------------------------------------------------
# Flush stdout/stderr immediately so logs appear in real time.
PYTHONUNBUFFERED=1
# Console + structured log verbosity.
POLYMARKET_LOG_LEVEL=INFO
# Human-readable chain label used for explorer links.
POLYMARKET_CHAIN=polygon
# Directory where runtime log files live.
LOG_DIR=log
# Structured runtime JSONL audit log path.
APP_LOG_JSONL_FILE=log/PolymarketCopyTradingBot.jsonl
# Max size of a single rotated runtime log file in bytes.
LOG_MAX_BYTES=5242880
# Number of rotated runtime log files to keep.
LOG_BACKUP_COUNT=3

# -----------------------------------------------------------------------------
# Polymarket / chain / signing
# -----------------------------------------------------------------------------
SIGNATURE_TYPE=2
CHAIN_ID=137
CLOB_HTTP_URL=https://clob.polymarket.com
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# -----------------------------------------------------------------------------
# Leader discovery / monitoring
# -----------------------------------------------------------------------------
FETCH_INTERVAL=0.25
LEADER_AUTO=false
LEADER_AUTO_COUNT=5
AUTO_DISCOVER_LEADERS=false
AUTO_DISCOVER_MAX_LEADERS=10
AUTO_DISCOVER_TOP_N=5
AUTO_DISCOVER_MIN_SCORE=0.45
FIND_TRADERS_TARGET=6
FIND_TRADERS_REFRESH_SECONDS=60

# -----------------------------------------------------------------------------
# Trading mode / sizing
# -----------------------------------------------------------------------------
SIZING_MODE=proportional
PERCENTAGE=1
FIXED_AMOUNT=3
BUY_MIN_AMOUNT=1
BUY_MAX_AMOUNT=8
MAX_POSITION_PCT=0.25
POSITION_THRESHOLD=0
ADAPTIVE_SIZING_BASIS=trade_size
TIERED_TRADE_MULTIPLIERS=
COPY_MIN_SHARES=5
COPY_MIN_NOTIONAL_USDC=1
COPY_SIZE_DECIMALS=4
TRADE_ANALYSIS_CONCURRENCY=6
RECONCILE_CONCURRENCY=4
EXECUTION_SUBMIT_CONCURRENCY=2
LEADER_ACTIVITY_MIN_FETCH_SPACING_MS=250
LEADER_POSITIONS_MIN_FETCH_SPACING_MS=250
MIN_LEADER_TRADE_NOTIONAL_USDC=1.00
TRUST_SIZE_MULTIPLIER_MIN=0.50
TRUST_SIZE_MULTIPLIER_MAX=1.25

# -----------------------------------------------------------------------------
# Signal quality / execution guards
# Recommended defaults:
# - MAX_RETRIES=3 keeps retries conservative
# - MAX_BOOK_SPREAD_BPS=2500 preserves current permissive execution behavior
# - FETCH_INTERVAL=0.25 and AGGREGATE_SIGNAL_WINDOW_SECONDS=0.1 favor faster copy execution
# - keep ENABLE_COPY_DECISION_GATE=false until BUY scoring is explicitly desired
# -----------------------------------------------------------------------------
# Max submit attempts for exchange order placement.
MAX_RETRIES=3
# Max attempts for ambiguous/non-terminal failures before giving up.
NON_TERMINAL_FAILURE_MAX_ATTEMPTS=3
# Base seconds for exponential retry backoff.
RETRY_BACKOFF_BASE=1.0
# Max allowed slippage percentage.
SLIPPAGE_TOLERANCE=2.0
# Reject BUYs below this market price; 0 disables the floor.
MIN_SHARE_PRICE=0.03
# Minimum token amount accepted by the venue.
MIN_ORDER_SIZE=0.00001
# Minimum BUY score required when copy decision gating is enabled.
COPY_DECISION_MIN_SCORE=0.15
# Max allowed percentage drift between leader trade price and live price.
COPY_MAX_PRICE_DRIFT_PCT=15
# Max allowed percentage edge decay before rejecting a copied BUY.
COPY_MAX_EDGE_DECAY_PCT=90
# Max signal age in seconds before a copied BUY is considered stale.
COPY_MAX_SIGNAL_AGE_SECONDS=100
AGGREGATE_SIGNAL_WINDOW_SECONDS=0.1
# Target liquidity used by copy decision sizing heuristics.
COPY_LIQUIDITY_TARGET_USDC=50
# Transaction fee model in basis points.
TRANSACTION_FEE_BPS=20
# Gas-cost model in USDC.
GAS_COST_USDC=0.03
# Extra risk buffer percentage applied by execution sizing checks.
RISK_BUFFER_PCT=0.10
# Orderbook spread gate mode: absolute_bps, relative_bps, or ticks.
BOOK_SPREAD_MODE=absolute_bps
# Max acceptable spread in basis points when spread mode uses bps.
MAX_BOOK_SPREAD_BPS=2500
# Max acceptable spread in ticks when BOOK_SPREAD_MODE=ticks.
MAX_BOOK_SPREAD_TICKS=0
# Force fresh orderbook reads for execution-time quality checks.
EXECUTION_REQUIRE_FRESH_BOOK=true
# Enable BUY-side near-resolution rejection logic.
ENABLE_NEAR_RESOLUTION_GATE=false
# Reject stale BUYs once price reaches this threshold.
NEAR_RESOLUTION_GATE_PRICE=0.95
# Max age in seconds allowed once a market is near resolution.
NEAR_RESOLUTION_MAX_AGE_SECONDS=15
# Expire stale pending submission locks after this many seconds.
PENDING_SUBMISSION_TTL_SECONDS=120
# Trip the execution circuit breaker after this many consecutive failures.
CIRCUIT_FAILURE_THRESHOLD=15
# Seconds to wait before the execution circuit breaker reopens.
CIRCUIT_COOLDOWN_SECONDS=60
# Cache TTL for healthy market metadata.
META_CACHE_TTL_GOOD=300
# Cache TTL for thin or suspicious market metadata.
META_CACHE_TTL_THIN=30

# -----------------------------------------------------------------------------
# Leader scoring
# -----------------------------------------------------------------------------
LEADER_SCORE_BALANCE_TARGET_USDC=500
LEADER_SCORE_PNL_BONUS_CAP=0.10
LEADER_SCORE_ACTIVITY_TARGET=8
LEADER_SCORE_WEIGHT_BALANCE=0.35
LEADER_SCORE_WEIGHT_ANALYTICS=0.45
LEADER_SCORE_WEIGHT_ACTIVITY=0.20
LEADER_SCORE_FLOOR=0.10

# -----------------------------------------------------------------------------
# Risk management / exits
# -----------------------------------------------------------------------------
ENABLE_RISK_MGMT=false
STOP_LOSS_PCT=20
TAKE_PROFIT_PCT=70
RISK_CHECK_INTERVAL=10
MAX_OPEN_POSITIONS=40
PROFIT_LOCK_TRIGGER_PCT=70
PROFIT_LOCK_MIN_PROFIT_PCT=35
PROFIT_LOCK_DRAWDOWN_PCT=15
NEAR_MAX_PRICE_WARN=0.95
NEAR_MAX_PRICE_WARN_TRIM_RATIO=0.50
NEAR_MAX_PRICE_EXIT=0.95
STAGED_TP_LEVELS=30,50
STAGED_TP_FRACTIONS=0.25,0.35

# -----------------------------------------------------------------------------
# Balance account-cap policy
# -----------------------------------------------------------------------------
ENABLE_BALANCE_TIERED_POLICY=false
DAY_START_EQUITY_USDC=50
BALANCE_POLICY_RESERVE_PCT=0.12
BALANCE_POLICY_RESERVE_FLOOR=7
BALANCE_POLICY_HARD_CAP_PCT=0.15
BALANCE_POLICY_HARD_CAP_CEILING=8
BALANCE_POLICY_MAX_OPEN_POSITIONS=12
BALANCE_POLICY_ALLOW_PARTIAL_EXITS=true
BALANCE_POLICY_ALLOW_PYRAMIDING=false
BALANCE_POLICY_MAX_ADDS_PER_POSITION=1
BALANCE_POLICY_BASE_MIN_SCORE=0.22
BALANCE_POLICY_MIN_NOTIONAL_USDC=0.00001
BALANCE_POLICY_DYNAMIC_THRESHOLD_RAISE=false

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_TIER_GATE_WATCHLIST=false
ENABLE_TIER_GATE_WATCHLIST_LOG=false
ENABLE_NEG_RISK_ARB=true
ENABLE_AUTO_REDEEM=true
ENABLE_METRICS_SERVER=false
KILL_SWITCH=false
ENABLE_PROFIT_LOCK=false
ENABLE_NEAR_MAX_EXIT=false
ENABLE_TRAILING_STOP=false
ENABLE_STAGED_TP=false
ENABLE_LEADER_DIVERGENCE_EXIT=false
ENABLE_COPY_DECISION_GATE=false
PAPER_TRADE_ONLY=false
ENABLE_NEAR_RESOLUTION_GATE=false
ENFORCE_GEOBLOCK=true

# -----------------------------------------------------------------------------
# Storage / persistence
# -----------------------------------------------------------------------------
# Enable SQLite state persistence.
BOT_STATE_DB_ENABLED=true
# SQLite database file path.
BOT_STATE_DB=data/bot_state.db
# Append-only realized/unrealized PnL JSONL output.
PNL_LOG_FILE=log/pnl.jsonl

# -----------------------------------------------------------------------------
# Metrics / reconciliation / health
# -----------------------------------------------------------------------------
METRICS_PORT=9102
METRICS_BIND_HOST=127.0.0.1
RECONCILE_STALE_SECONDS=3600
RECONCILE_AUTO_CANCEL=false
RECONCILE_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# External services / automation
# -----------------------------------------------------------------------------
REDEEM_CHECK_INTERVAL=60
