# Runtime
PYTHONUNBUFFERED=1

# Wallet configuration
# Comma-separated leader wallets to follow. If empty, USER_ADDRESS is used.
LEADER_WALLETS=
# Leader wallet to copy (fallback if LEADER_WALLETS is empty)
USER_ADDRESS=

# Wallet that actually holds tradable funds
FUNDER_ADDRESS=

# Optional legacy alias; if set it is used as funder fallback.
PROXY_WALLET=

# Wallet signing key or file path (PRIVATE_KEY_FILE has priority)
PRIVATE_KEY=
PRIVATE_KEY_FILE=

# Signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
SIGNATURE_TYPE=2
CHAIN_ID=137

# Endpoints
CLOB_HTTP_URL=https://clob.polymarket.com
RPC_URL=
MONGO_URI=
MULTI_USER_CONFIG_FILE=

# Contracts
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Polling and execution
FETCH_INTERVAL=1
AUTO_DISCOVER_LEADERS=false
AUTO_DISCOVER_MAX_LEADERS=10
AUTO_DISCOVER_TOP_N=5
AUTO_DISCOVER_MIN_SCORE=0.45
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
SLIPPAGE_TOLERANCE=2.0
# Minimum BUY quote price to allow (0 disables)
MIN_SHARE_PRICE=0
MIN_ORDER_SIZE=0.00001

# Sizing
# proportional | fixed | adaptive
SIZING_MODE=proportional
PERCENTAGE=25
FIXED_AMOUNT=10
BUY_MIN_AMOUNT=1
BUY_MAX_AMOUNT=100
MAX_POSITION_PCT=0.10
# 0 disables threshold filtering
POSITION_THRESHOLD=0
# Decision-first engine
COPY_MIN_SHARES=5
COPY_MIN_NOTIONAL_USDC=1
COPY_SIZE_DECIMALS=4
COPY_DECISION_MIN_SCORE=0.32
COPY_MAX_PRICE_DRIFT_PCT=6
COPY_MAX_EDGE_DECAY_PCT=70
COPY_MAX_SIGNAL_AGE_SECONDS=120
COPY_LIQUIDITY_TARGET_USDC=50
TRUST_SIZE_MULTIPLIER_MIN=0.70
TRUST_SIZE_MULTIPLIER_MAX=1.25
LEADER_SCORE_BALANCE_TARGET_USDC=500
LEADER_SCORE_PNL_BONUS_CAP=0.10
LEADER_SCORE_ACTIVITY_TARGET=8
LEADER_SCORE_WEIGHT_BALANCE=0.35
LEADER_SCORE_WEIGHT_ANALYTICS=0.45
LEADER_SCORE_WEIGHT_ACTIVITY=0.20
LEADER_SCORE_FLOOR=0.10

# Risk management
ENABLE_RISK_MGMT=true
STOP_LOSS_PCT=20
TAKE_PROFIT_PCT=70
RISK_CHECK_INTERVAL=10
# Exit extensions
PROFIT_LOCK_TRIGGER_PCT=70
PROFIT_LOCK_MIN_PROFIT_PCT=35
PROFIT_LOCK_DRAWDOWN_PCT=15
NEAR_MAX_PRICE_WARN=0.95
NEAR_MAX_PRICE_WARN_TRIM_RATIO=0.50
NEAR_MAX_PRICE_EXIT=0.95
# Legacy aliases (optional; new names above take precedence if both are set):
# NEAR_97_PARTIAL_TRIM_PRICE=0.95
# NEAR_97_PARTIAL_TRIM_RATIO=0.50
# NEAR_99_FULL_EXIT_PRICE=0.95
TRANSACTION_FEE_BPS=20
GAS_COST_USDC=0.03
RISK_BUFFER_PCT=0.5

# Auto-redeem
ENABLE_AUTO_REDEEM=true
REDEEM_CHECK_INTERVAL=60

# Persistence
BOT_STATE_DB=data/bot_state.db
PNL_LOG_FILE=log/pnl.jsonl
ENABLE_METRICS_SERVER=false
METRICS_PORT=9102
ENFORCE_GEOBLOCK=true
