# Sensitive-only template.
# Keep non-sensitive runtime settings in: config/runtime.local.env
# Keep wallet lists / public addresses / strategy knobs out of `secrets.env` unless you
# intentionally want local-only overrides.

# -----------------------------------------------------------------------------
# Chain / RPC secrets
# -----------------------------------------------------------------------------
# Polygon RPC endpoint. If your provider URL embeds an API key, keep it here.
RPC_URL=

# -----------------------------------------------------------------------------
# Exchange / relayer secrets
# -----------------------------------------------------------------------------
# Optional Polymarket CLOB API key.
CLOB_API_KEY=

# Optional relayer auth token for proxy/safe redemption flow.

# -----------------------------------------------------------------------------
# Wallet secrets
# -----------------------------------------------------------------------------
# Hex private key (0x + 64 hex chars).
PRIVATE_KEY=

# Optional path to a private key file. Takes precedence over PRIVATE_KEY.
PRIVATE_KEY_FILE=

# -----------------------------------------------------------------------------
# Database (PostgreSQL via asyncpg)
# -----------------------------------------------------------------------------
# Default targets the local docker compose stack; swap to managed PG
# (Supabase / Neon / RDS) by replacing the host:port.
DATABASE_URL=postgresql://bot:bot@localhost:5432/polymarket_bot
