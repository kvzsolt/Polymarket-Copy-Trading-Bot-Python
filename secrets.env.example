# Copy to secrets.env, fill locally, then run: chmod 600 secrets.env
# Never commit the populated file.
# The database superuser password is NOT here: it lives in db.env (see
# db.env.example), read only by the compose postgres service. This file is
# read only by the bot service.
# Followed leaders are configured in config/traders/<name>.yml (one file per
# leader, including optional eoa_address and proxy_address), never here.

PMCOPY__DATABASE__DSN=
PMCOPY__WALLET__PRIVATE_KEY=

# Optional immutable startup override: paper or live.
# Prefer selecting the environment instead: PMCOPY_ENVIRONMENT=live loads
# config/environments/live/execution.yml (trading_mode: live).
# PMCOPY__EXECUTION__TRADING_MODE=paper

# Required Alchemy Polygon WebSocket endpoint (e.g. wss://polygon-mainnet.g.alchemy.com/v2/<key>).
# The matching HTTPS RPC endpoint is derived automatically from the same key for startup health checks.
PMCOPY__ALCHEMY_WSS_URL=

# Leader detection mode (strictly enforced at startup):
#   on_chain_logs_only          - server-side per-user filtered OrderFilled logs (near-$0 CU cost)
#   on_chain_pending            - Exchange-locked mempool matchOrders stream + fast hex pre-filter
#   confirmed+mempool_reserved  - mempool pre-reservation + confirmed OrderFilled promotion
PMCOPY__DETECTION__MODE=on_chain_logs_only

# Optional WSS cost controls (safe defaults shown):
# PMCOPY__INCLUDE_LEGACY_V1_EXCHANGES=false
# PMCOPY__TRACK_DIRECT_USER_TXS=false
# PMCOPY__MAX_HOURLY_WS_MB=250

PMCOPY__DISCOVERY__API__TOKEN=

# No CLOB apiKey/secret/passphrase belong here. The runtime derives credentials
# in memory from the EOA key; live signing is fixed to Deposit Wallet
# (POLY_1271 / signature type 3).

# Optional manual gasless redemption: pmcopy redeem --execute
# Obtain a Polymarket Relayer API key (not a CLOB key or Builder credential).
# The address is the EOA that owns the Relayer key and signs for the Deposit Wallet.
PMCOPY__REDEMPTION__RELAYER_API_KEY=
PMCOPY__REDEMPTION__RELAYER_API_KEY_ADDRESS=
