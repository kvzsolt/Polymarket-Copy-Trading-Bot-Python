# Copy to secrets.env, fill locally, then run: chmod 600 secrets.env
# Never commit the populated file. AppConfig accepts only PMCOPY__ nested keys;
# POSTGRES_PASSWORD remains plain because the official Postgres image reads it.
# Followed leaders are configured in config/traders/<name>.yml (one file per
# leader), never in this secrets file.
#
# Legacy pre-split names (PMCOPY__NETWORK__*, PMCOPY__ONCHAIN_DETECTION__*)
# keep working through the loader's translation table; the canonical names
# below match the service-owned config files.

POSTGRES_PASSWORD=
PMCOPY__DATABASE__DSN=
PMCOPY__WALLET__PRIVATE_KEY=

# Optional immutable startup override: paper or live.
# Prefer selecting the environment instead: PMCOPY_ENVIRONMENT=live loads
# config/environments/live/execution.yml (trading_mode: live).
# PMCOPY__EXECUTION__TRADING_MODE=paper

# Optional integrations — fill only when the matching feature is enabled.
# Public defaults live in config/polymarket.yml and config/detection.yml;
# override here only with private endpoints.
PMCOPY__POLYMARKET__RPC_URL=
PMCOPY__POLYMARKET__FALLBACK_RPC_URL=
PMCOPY__DETECTION__ONCHAIN__ONCHAIN_WS_URL=
PMCOPY__DETECTION__ONCHAIN__PENDING_TX_WS_URL=
# Optional per-host detection source override: polling | on_chain_pending |
# on_chain_confirmed. Environment files select it by default
# (config/environments/live/detection.yml = on_chain_confirmed +
# confirmed_source logs_only, i.e. live copies off the mined OrderFilled log;
# paper stays polling); every non-polling mode requires one of the wss:// URLs
# above. logs_only runs on ANY wss:// provider that offers eth_subscribe
# (Alchemy, Infura, QuickNode, self-hosted); on_chain_pending and
# on_chain_confirmed + mempool_reserved additionally require Alchemy
# (alchemy_pendingTransactions). Set on_chain_pending here to flip the live
# host back to the faster provisional mempool copy. Restart required to change.
PMCOPY__DETECTION__MODE=
PMCOPY__DISCOVERY__API__TOKEN=

# Operator API (127.0.0.1:9103), enabled by config/environments/live/control_plane.yml.
# Required whenever the control plane is enabled; startup fails closed without it.
PMCOPY__CONTROL_PLANE__AUTH__TOKEN=
# Optional second credential: every read plus the telemetry stream, no writes.
# Must differ from the operator value above. Leave blank to issue no viewer role.
PMCOPY__CONTROL_PLANE__AUTH__VIEWER_TOKEN=

# No CLOB apiKey/secret/passphrase belong here.  The unified SDK uses the
# private key for L1 auth, create-or-derives those credentials in memory, then
# uses them for L2 HMAC requests.  Live signing is fixed to Deposit Wallet
# (POLY_1271 / signature type 3).
