# Copy to db.env, fill locally, then run: chmod 600 db.env
# Never commit the populated file.
#
# This file is read ONLY by the postgres service in docker-compose.yml and
# holds ONLY the database superuser password. All bot secrets (wallet key,
# DSN, discovery token, relayer keys) stay in secrets.env: postgres never
# receives that file, and the bot never receives this one.
#
# Leave the value empty and the official postgres image refuses to start
# (fail-closed: there is deliberately no default password). Generate one with:
#   openssl rand -hex 24
# The password must match an already-initialized volume; changing it here does
# not rotate an existing PostgreSQL user's password.
POSTGRES_PASSWORD=
