# Keep wallet credentials, local-only runtime overrides, and dev
# artifacts out of the Docker image. Baking secrets.env into a
# build layer leaves the key in layer history even if a later
# step deletes the file.
secrets.env
secrets.env.*
!secrets.env.example
db.env
db.env.*
!db.env.example
.env
.env.*
config/runtime.local.yml
config/runtime.local.*
secrets.toml
*.env.bak
*.env.bak.*
*.env.backup
*.env.backup.*
config/bot.toml
src/pmcopy/config/runtime.local.yml
src/pmcopy/config/runtime.local.*
src/pmcopy/config/bot.toml

# VCS / CI metadata — image does not need them.
.git/
.github/
.gitignore
.worktrees/

# Agent/assistant working state — never bake into the build context.
.superpowers/
.mimosa/
.zcode/
.claude/
.codex/
.memory/
memory/

# Local dev state
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data + logs — mount as volumes, do not embed.
data/
log/
logs/

# Tests + planning docs — not needed in runtime image.
tests/
docs/
reviews/
audit.md
plan.md
*.md
# README is pyproject metadata ("readme"): `pip install .` fails without it.
!README.md

# IDE
.idea/
.vscode/
.kilo/
.qodo/
.proxyai/
.codex

# Misc
0
_handle_*
*.egg-info/
build/
dist/
